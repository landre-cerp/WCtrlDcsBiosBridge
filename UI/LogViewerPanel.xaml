<UserControl
    x:Class="WCtrlDcsBiosBridge.UI.LogViewerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="LogViewerHeader" x:Uid="LogViewerHeader"
                   Text="Application log"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,6"
                   HorizontalAlignment="Center"/>

        <!-- Resolved path. Selectable: a user who would rather open the file themselves,
             or attach it to a bug report, needs to be able to copy it. -->
        <TextBlock Grid.Row="1"
                   x:Name="LogPathText"
                   FontSize="11"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource SubtleTextForeground}"/>

        <!-- Body. NoWrap plus a horizontal scrollbar: a log line carries a timestamp, a level
             and a message, and wrapping it shuffles those into an unreadable block. -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <ScrollViewer x:Name="LogScroll"
                          MaxHeight="460"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled">
                <TextBlock x:Name="LogText"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="NoWrap"
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Border>

        <!-- Copy confirmation -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,10,0,0"
                   Visibility="Collapsed"
                   Foreground="{StaticResource HelpTextForeground}"/>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Errors-only filter. A ToggleButton rather than a plain one: the filter hides
                 content, and the user has to be able to see at a glance that what they are
                 reading is a subset. -->
            <primitives:ToggleButton x:Name="ErrorsOnlyToggle"
                                     x:Uid="LogViewerErrorsOnlyButtonControl"
                                     Grid.Column="0"
                                     Content="Errors only"
                                     MinWidth="110"
                                     VerticalAlignment="Center"
                                     Checked="ErrorsOnlyToggle_Toggled"
                                     Unchecked="ErrorsOnlyToggle_Toggled"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CopyButton"
                        x:Uid="LogViewerCopyButtonControl"
                        Content="Copy"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Click="CopyButton_Click"/>
                <Button x:Name="CloseButton"
                        x:Uid="LogViewerCloseButtonControl"
                        Content="Close"
                        MinWidth="100"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
